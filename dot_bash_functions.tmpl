# Open a file in nvim after fzf'ing for it 
function fzvim() {
    nvim -o $(fzf)
}
# Extracts any archive(s) (if unp isn't installed)
function extract() {
	for archive in "$@"; do
		if [ -f "$archive" ]; then
			case $archive in
			*.tar.bz2) tar xvjf $archive ;;
			*.tar.gz) tar xvzf $archive ;;
			*.bz2) bunzip2 $archive ;;
			*.rar) rar x $archive ;;
			*.gz) gunzip $archive ;;
			*.tar) tar xvf $archive ;;
			*.tbz2) tar xvjf $archive ;;
			*.tgz) tar xvzf $archive ;;
			*.zip) unzip $archive ;;
			*.Z) uncompress $archive ;;
			*.7z) 7z x $archive ;;
			*) echo "don't know how to extract '$archive'..." ;;
			esac
		else
			echo "'$archive' is not a valid file!"
		fi
	done
}

# Searches for text in all files in the current folder
function ftext() {
	# -i case-insensitive
	# -I ignore binary files
	# -H causes filename to be printed
	# -r recursive search
	# -n causes line number to be printed
	# optional: -F treat search term as a literal, not a regular expression
	# optional: -l only print filenames and not the matching lines ex. grep -irl "$1" *
	grep -iIHrn --color=always "$1" . | less -r
}

# IP address lookup
alias whatismyip="whatsmyip"
function whatsmyip () {
    # Internal IP Lookup.
{{- if eq .chezmoi.os "linux" }}
    if command -v hostname >/dev/null 2>&1; then
        echo -n "Internal IP: "
        # hostname -I prints space-separated addresses; take the first
        hostname -I | awk '{print $1}'
    else
        echo -n "Internal IP: "
        # Fallback via ip(8)
        ip -4 addr show \
          | awk '/inet / && $2 !~ /^127\./ {print $2}' \
          | cut -d/ -f1 \
          | head -n 1
    fi
{{- else if eq .chezmoi.os "darwin" }}
    if command -v ipconfig >/dev/null 2>&1; then
        echo -n "Internal IP: "
        # Common Wi‑Fi interface on Macs; adjust if you use a different NIC
        ipconfig getifaddr en0
    else
        echo "ipconfig not found"
    fi
{{ end }}
}
# Use fzf to cd into a directory
function fzfz(){
        local dir=$(find . -type d -print | fzf)
        if [ "$dir" = "" ]; then
           cd ./
        else
           cd $dir
        fi
}

function totalDiff(){
    git diff -w $(git branch --show-current) -- "$1"
}

function pullPR(){
    PR_ID=$1
    echo "Pulling PR #${PR_ID} from  $(git remote show upstream | grep "Fetch URL")"
    git fetch upstream refs/pull-requests/$PR_ID/from:pr-$PR_ID
}
