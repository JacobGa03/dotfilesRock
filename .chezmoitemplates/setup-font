{{ define "setup-font" }}
FONT_NAME="DroidSansM Nerd Font"
FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/DroidSansMono.zip"
{{ if eq .chezmoi.os "linux" -}}
FONT_DIR="$HOME/.local/share/fonts/DroidSansMono"
{{- else -}}
FONT_DIR="$HOME/Library/Fonts"
{{- end }}

if find "$FONT_DIR" -iname "*DroidSansM*" 2>/dev/null | grep -q .; then
    echo "$FONT_NAME already installed"
else
    mkdir -p "$FONT_DIR"
    TEMP_DIR=$(mktemp -d)
    curl -fLo "$TEMP_DIR/DroidSansMono.zip" "$FONT_URL"
    unzip -q "$TEMP_DIR/DroidSansMono.zip" -d "$FONT_DIR"
    rm -rf "$TEMP_DIR"
{{ if eq .chezmoi.os "linux" }}    fc-cache -fv
{{ end }}    echo "$FONT_NAME installed successfully"
fi
{{ end }}
