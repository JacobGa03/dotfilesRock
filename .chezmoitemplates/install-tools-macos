{{ define "install-tools-macos" }}
function is_installed() {
    local package_type=$(set_package_type "$2")
    brew list "$package_type" "$1" | grep -qx "$1"
}

function is_outdated() {
    local package_type=$(set_package_type "$2")
    brew outdated "$package_type" "$1" | grep -qx "$1"
}

function set_package_type() {
    if [[ "$1" == formula ]]; then
        echo "--formula"
    else
        echo "--cask"
    fi
}

echo "Installing tools from Homebrew..."

if ! command -v brew &>/dev/null; then
    echo "Homebrew not found, installing now..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

brew update -q

packages_fomrulae=(
    fzf
    eza
    ripgrep
    git
    zoxide
    neovim
    bash
    luarocks
    diff-so-fancy
    git
    tmux
    lazygit
    yazi
    asmvik/formulae/yabai
    koekeishiya/formulae/skhd
)

packages_cask=(
    wezterm
)

for package in "${packages_fomrulae[@]}"; do
    if ! is_installed "$package" "formula"; then
        brew install "$package"
    elif is_outdated "$package" "formula"; then
        brew upgrade "$package"
    else
        echo "$package is up to date!"
    fi
done

for package in "${packages_cask[@]}"; do
    if ! is_installed "$package" "cask"; then
        brew install --cask "$package"
    elif is_outdated "$package" "cask"; then
        brew upgrade --cask "$package"
    else
        echo "$package is up to date!"
    fi
done

echo "Installed all CLI tools for macOS!"

if [[ ! -d ~/.tmux/plugins/ ]]; then
    echo "Installing TPM..."
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
else
    echo "TPM is already installed!"
fi
{{ end }}
