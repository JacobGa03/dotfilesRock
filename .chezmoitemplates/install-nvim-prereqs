{{ define "install-nvim-prereqs" }}
echo "#####Installing outside dependencies for Neovim#####"
if ! command -v rustup &> /dev/null; then
    echo "Installing rust up..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
    source ~/.cargo/env
fi

# Needed for tree-sitter
if command -v tree-sitter --version &> /dev/null; then
    echo "tree-sitter-cli installed..."
else
    echo "Installing tree-sitter-cli from cargo..."
    cargo install tree-sitter-cli
fi
{{ end }}
