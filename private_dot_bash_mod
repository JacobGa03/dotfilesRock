# Restore jars to either their reduced or original form
function restoreJars() {
    # Delete the contents of main and copy over the reduced (or original) jars
    rm -r $T24_MAIN
    mkdir $T24_MAIN

    # Restore to the orignal jars
    if [[ $1 == "original" ]]; then
        cp -r $T24_ORIGINAL $T24_MAIN
        echo "Restored to original T24 library"
    # Restore to the reduced jars
    elif [[ $1 == "reduced" ]]; then
        cp -r $REDUCED_LOCATION $T24_MAIN
        echo "Restored to reduced library generated by 'modularitypackager'"
    else
        echo "Input not recognized. Try 'original' or 'reduced'"
    fi
}
# Restore original DB
function restoreDB() {
    cp $MODULARITY_BASE/H2/DDAComposability_API_COB.mv.db $MODULARITY_BASE/H2/DDAComposability.mv.db
}

function runModularityPackager() {
    cd $MODULARITY_BASE/modularitypackager/target/bin
    ./ModularityPackager.sh $*

    cd $MODULARITY_BASE
}

# Start both the H2 and JBoss envoirnments in one click for you.
function startUTP() {
    echo "Starting UTP Enviornment..."
    # Start the jboss enviornment and put it in the background
    (cd $MODULARITY_BASE/UTP_DDA/Temenos/ && ./StartJboss.sh >$MODULARITY_BASE/jboss_temp.log 2>&1 &)
    jboss_pid=$!

    # Jank way to sleep until the process is up and running!
    while [[ $(lsof -ti tcp:9089 | wc -l) -lt 1 ]]; do
        echo "JBoss Not Ready."
        sleep 1
        tput cuu1 # Move the cursor up one line
        tput el   # Clear the line
        echo "JBoss Not Ready.."
        sleep 1
        tput cuu1 # Move the cursor up one line
        tput el   # Clear the line
        echo "JBoss Not Ready..."
        sleep 1
        tput cuu1 # Move the cursor up one line
        tput el   # Clear the line
    done

    # Start H2 database
    local db=""
    echo "Starting H2 Database..."
    if [[ -z $1 ]]; then
        echo "No database specified, using DDAComposability"
        db="DDAComposability"
    elif [[ $1 == *.mv.db ]]; then
        db="${1%.*.*}"
    fi

    cd $MODULARITY_BASE/H2/ && ./StartH2.sh "$db"
    h2_pid=$!

    echo "Shutting UTP Down!!!"
    kill -9 $(lsof -ti tcp:3456,9089)

    rm -r $MODULARITY_BASE/ModularityDeposits/
    mkdir $MODULARITY_BASE/ModularityDeposits/
    local stillContinue

    # Start transact and h2 database
    if [[ $(monUTP | wc -l) -eq 0 ]]; then
        restoreJars "original"
        restoreDB
        echo "Starting the UTP and H2"
        osascript -e 'tell application "Terminal" to do script "startUTP DDAComposability"'
        sleep 2
    else
        echo "Transact already running"
    fi

    # Show the jars being generated in realtime
    echo "Open ModuarlityDeposits folder and show the jars being generated"
    open $MODULARITY_BASE/ModularityDeposits
    echo "Run the modularitypackager"
    read stillContinue
    osascript -e 'tell application "Terminal" to do script "cd $MODULARITY_BASE/modularitypackager/target/bin"'
    sleep 2

    # Show differences in jar size
    echo "Difference in jar sizes between original and reduced"
    read stillContinue
    du -h ~/t24lib
    du -h $MODULARITY_BASE/ModularityDeposits/lib

    # Show differences in database size
    echo "Ensure you write SHUTDOWN_COMPACT; in H2 shell"
    echo "Difference in database sizes between original and reduced"
    read stillContinue
    du -h $MODULARITY_BASE/H2/DDAComposability_API_COB.mv.db
    du -h $MODULARITY_BASE/H2/DDAComposability.mv.db
}
# For local macos dev enviornment
export DEV_PACK_LOCATION=/Users/jacob.gadberry/Modularity/automation-dev
DEPOSITS_DB="/Users/jacob.gadberry/Modularity/auto-test/psql dump/deposits.dump"
LENDING_DB="/Users/jacob.gadberry/Modularity/auto-test/psql dump/lending.dump"

function startKubes() {
    cd "$DEV_PACK_LOCATION"/local
    chmod -R 777 *

    build="${build:-y}"

    set +a
    source services.conf
    source databases.conf
    set -a

    echo "Checking kubectl context to ensure you are running locally"
    context=$(kubectl config current-context)
    if [[ "$context" != "rancher-desktop" ]]; then
        echo "Not in proper context, changing now..."
        kubectl config use-context rancher-desktop
    fi

    if pg_isready -q; then
        echo "Postgres is up and running!"
    else
        echo "Postgres is not running. Starting now!"
        brew services start postgresql@17
        sleep 2
    fi

    # All sed commands touch the same file — must stay sequential
    echo "Updating databases.conf with current private IPv4..."
    sed -E -i '' 's/^([[:alnum:]_]+_DB_HOST=).*/\1'"$(ipconfig getifaddr en0)"'/' ./databases.conf
    echo "Updating port assignments for the databases..."
    if [[ "$TRANSACT_DATABASE" == "h2d" ]]; then
        sed -E -i '' "s/(TRANSACT_DB_PORT=)([0-9]{4})?/\13456/" ./databases.conf
    else
        sed -E -i '' "s/(TRANSACT_DB_PORT=)([0-9]{4})?/\15432/" ./databases.conf
    fi
    if [[ "$DEPOSITS_DATABASE" == "h2d" ]]; then
        sed -E -i '' "s/(DEPOSITS_DB_PORT=)([0-9]{4})?/\13457/" ./databases.conf
    else
        sed -E -i '' "s/(DEPOSITS_DB_PORT=)([0-9]{4})?/\15432/" ./databases.conf
    fi
    if [[ "$LENDING_DATABASE" == "h2d" ]]; then
        sed -E -i '' "s/(LENDING_DB_PORT=)([0-9]{4})?/\13458/" ./databases.conf
    else
        sed -E -i '' "s/(LENDING_DB_PORT=)([0-9]{4})?/\15432/" ./databases.conf
    fi
    sed -E -i '' "s/(MICROSERVICES_DB_PORT=)([0-9]{4})?/\15432/" ./databases.conf

    # Per-service DB setup — independent databases, run in parallel
    (
        [[ "$TRANSACT_DATABASE" == "h2d" ]] && [[ "$service" == "transact" ]] &&
            cd scripts && startH2D "transact" 3456
    ) &
    (
        if [[ "$DEPOSITS_DATABASE" == "h2d" ]] && [[ "$service" == "deposits" ]]; then
            cd scripts && startH2D "deposits" 3457
        elif [[ "$service" == "deposits" ]]; then
            cd scripts && setUpPostgres "deposits" "$DEPOSITS_DB"
        fi
    ) &
    (
        if [[ "$LENDING_DATABASE" == "h2d" ]] && [[ "$service" == "lending" ]]; then
            cd scripts && startH2D "lending" 3458
        elif [[ "$service" == "lending" ]]; then
            cd scripts && setUpPostgres "lending" "$LENDING_DB"
        fi
    ) &
    wait

    # Registry must be up before infra (may pull images) and build (pushes images)
    cd "$DEV_PACK_LOCATION"/local/scripts
    ./start-container-registry.sh
    sleep 2

    # Infra and image build are independent — run in parallel
    ./start-infra.sh &
    infra_pid=$!
    if [[ "$build" == "y" ]]; then
        echo "$build" | ./build-images.sh -A &
        build_pid=$!
    else
        build_pid=0
    fi

    wait $infra_pid
    infra_exit=$?
    if [[ $build_pid -gt 0 ]]; then
        wait $build_pid
        build_exit=$?
    else
        build_exit=0
    fi

    if [[ $infra_exit -ne 0 || $build_exit -ne 0 ]]; then
        echo "Infra (exit=$infra_exit) or build (exit=$build_exit) failed. Aborting."
        return 1
    fi

    sleep 10 # allow infra pods to become ready

    echo "y" | ./start-services.sh -s deposits,lending,payments,genericconfig,adapterservice,eventstore
    start_exit=$?

    wait $start_exit

    ./configure-services.sh -s payments

    echo "All kube commands executed!"
}

function startH2D() {
    local dbName="$1"
    local port="$2"

    if [ -z $(lsof -ti tcp:$port) ]; then
        echo "Starting $dbName database"
        ./start-db-h2.sh "$dbName" "$port"
        sleep 2
    fi
}

function setUpPostgres() {
    local dbName="$1"
    local dumpFile="$2"

    ./create-database.sh "$dbName" "$dumpFile"
}

function stopKubes() {
    wipe_image_registry="${1:-n}"

    cd "$DEV_PACK_LOCATION"/local/scripts

    echo "Checking kubectl context to ensure you are running locally"
    context=$(kubectl config current-context)
    if [[ "$context" != "rancher-desktop" ]]; then
        echo "'rancher-desktop' is not your current context. Switching now"
        kubectl config use-context rancher-desktop
    fi

    # All stop operations are independent — run in parallel
    ./stop-infra.sh &
    infra_pid=$!

    echo "y" | ./stop-services.sh -A &
    services_pid=$!

    if [[ "$wipe_image_registry" =~ ^[Yy]$ ]]; then
        echo "Stopping container registry and deleting its contents..."
        echo "$wipe_image_registry" | ./stop-container-registry.sh &
        registry_pid=$!
    fi

    # H2 kills are instant local process kills — run inline while kubectl jobs run
    echo "Stopping H2 databases if they are active"
    for pid in $(lsof -ti tcp:3456,3457,3458); do kill -9 $pid; done
    echo "Cleaned up databases!"

    wait $infra_pid
    wait $services_pid || echo "Didn't stop the services"
    [[ -n "${registry_pid:-}" ]] && wait $registry_pid

    echo "Done stopping kubes"
}
# Fuzzy find thorugh pod names, and select one
function fuzzyKubes() {
    namespace="$1"

    if [[ -z "$1" ]]; then
        echo "Provide a namespace"
        return
    fi
    echo $(kubectl get pods -n "$namespace" -o custom-columns=:metadata.name | fzf)
}

function kexec() {
    podName=$(fuzzyKubes "$1")
    if [[ -n "$podName" ]]; then
        kubectl exec -it "$podName" -n "$1" -- /bin/bash
    else
        echo "You have to choose a pod!"
    fi
}

function klog() {
    podName=$(fuzzyKubes "$1")
    if [[ -n "$podName" ]]; then
        kubectl logs "$podName" -n "$1"
    else
        echo "You have to choose a pod!"
    fi
}

function kdesc() {
    podName=$(fuzzyKubes "$1")
    if [[ -n "$podName" ]]; then
        kubectl describe pod ${podName#pod/} -n "$1"
    else
        echo "You have to choose a pod!"
    fi
}

function kconfig() {
    config=$(k config get-contexts | awk '{ print $2 }' | fzf)

    kubectl config use-context "$config"
}

function killLending() {
    echo "Deleting Lending Deployment"
    helm uninstall lending -n lending
    sleep 2
    helm uninstall ingress-nginx-lending -n ingress-nginx-lending
    sleep 2
    kubectl delete ns lending
    sleep 2
    kubectl delete ns ingress-nginx-lending

}
# Interactivley select db dump files to create the database for
# Transact-based services
function dumpDB() {
    service="$1"

    if [[ -z "$service" ]]; then echo "Indicate a service to create a db for!" && return 1; fi

    dump=$(ls ${DEV_PACK_LOCATION}/local/artefacts/${service}/db-h2/*{dump,sql} | xargs basename | fzf)

    if [[ -z "$dump" ]]; then echo "No dump selected" && return 1; fi

    ${DEV_PACK_LOCATION}/local/scripts/create-database.sh "$1" "${DEV_PACK_LOCATION}/local/artefacts/${service}/db-h2/${dump}"
    exitStat=$?

    # Just to keep track of the last run create database script, just to
    # know what the "working" dump file is
    if [[ "$exitStat" -eq 0 ]]; then
        echo "====Creating a new database for ${service} @ $(date)====" >>"${DEV_PACK_LOCATION}/local/artefacts/db-dump.log"
        echo "===Using $(basename "$dump") as the source dump file===" >>"${DEV_PACK_LOCATION}/local/artefacts/db-dump.log"
    else
        echo "Failure re-creating database!! :("
    fi

}
# Run jboss-cli commands through the Transact-based pods
# Passing a command at $2 is optional, if none is passed then you auto-connect into the cli
function jbossCon() {
    podName=$(fuzzyKubes "$1")
    command="$2"
    if [[ -n "$podName" ]] && [[ -n "$command" ]]; then
        kubectl exec -it "$podName" -n "$1" -- /opt/jboss/wildfly/bin/jboss-cli.sh --connect --command="$command"
    elif [[ -n "$podName" ]]; then
        kubectl exec -it "$podName" -n "$1" -- /opt/jboss/wildfly/bin/jboss-cli.sh --connect
    else
        echo "You have to choose a pod!"
    fi

}
