rebuildRestart() {
    cd "$DEV_PACK_LOCATION"/local/scripts
    namespace="$1"

    echo "Stopping and rebuilding $namespace in parallel..."
    echo "y" | ./stop-services.sh -s "$namespace" &
    stop_pid=$!
    chmod -R 777 *
    echo "y" | ./build-images.sh -s "$namespace" &
    build_pid=$!

    wait $stop_pid
    stop_exit=$?
    wait $build_pid
    build_exit=$?

    if [ $stop_exit -ne 0 ] || [ $build_exit -ne 0 ]; then
        echo "Stop or build failed (stop=$stop_exit, build=$build_exit). Aborting."
        return 1
    fi

    echo "Starting $namespace..."
    echo "y" | ./start-services.sh -s "$namespace"
}

runOFSRequest() {
    NAMESPACE=""
    UNIQ_REF=""
    BANK_REF=""
    ACCT_ID=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
        -n | --namespace)
            NAMESPACE="$2"
            shift 2
            ;;
        --uniq-ref)
            UNIQ_REF="$2"
            shift 2
            ;;
        --bank-ref)
            BANK_REF="$2"
            shift 2
            ;;
        --acct-id)
            ACCT_ID="$2"
            shift 2
            ;;
        *)
            shift
            ;;
        esac
    done

    [[ -z "$NAMESPACE" ]] && {
        echo "ERROR: --namespace is required" >&2
        return 1
    }
    [[ -z "$UNIQ_REF" ]] && {
        echo "ERROR: --uniq-ref is required" >&2
        return 1
    }
    [[ -z "$BANK_REF" ]] && {
        echo "ERROR: --bank-ref is required" >&2
        return 1
    }
    [[ -z "$ACCT_ID" ]] && {
        echo "ERROR: --acct-id is required" >&2
        return 1
    }

    POD=$(kubectl get pods -n "$NAMESPACE" --field-selector=status.phase=Running -o name | sed 's|pod/||' | fzf)
    [[ -z "$POD" ]] && {
        echo "ERROR: no running pod found in namespace '$NAMESPACE'" >&2
        return 1
    }

    printf "OFS Message (use {UNIQ_REF}, {BANK_REF}, and {ACCT_ID} as placeholders): "
    read -r OFS_TEMPLATE

    OFS_MSG="${OFS_TEMPLATE//\{UNIQ_REF\}/${UNIQ_REF}}"
    OFS_MSG="${OFS_MSG//\{BANK_REF\}/${BANK_REF}}"
    OFS_MSG="${OFS_MSG//\{ACCT_ID\}/${ACCT_ID}}"

    echo ""
    echo "Sending to pod '${POD}' in namespace '${NAMESPACE}'..."
    echo ""

    kubectl exec -n "$NAMESPACE" "$POD" -- \
        bash -c "cd /srv/Temenos/TAFJ/bin && echo '${OFS_MSG}' | bash tRun tSS IN.CTI.MSG"
}
