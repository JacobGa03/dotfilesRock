## History Control
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt APPEND_HISTORY
HISTSIZE=1000
SAVEHIST=2000
HISTFILE=~/.zsh_history
 
if [[ -f ~/.bash_aliases ]]; then
    source ~/.bash_aliases
fi

if [[ -f ~/.bash_functions ]]; then
    source ~/.bash_functions
fi

if [[ -f ~/.bash_mod ]]; then
    source ~/.bash_mod
fi

# zsh autocomplete
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  fast-syntax-highlighting
  zsh-autocomplete
 )

# VENV
# --- Venv Display ---
get_venv_name() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        echo "($(basename "$VIRTUAL_ENV"))"
    fi
}
update_vcs_info() {
    vcs_info
    # Venv prompt (only if active)
    VENV_PROMPT=""
    if [[ -n "$VIRTUAL_ENV" ]]; then
        VENV_PROMPT="$OPEN_BRACKET%F{$GREEN}$(get_venv_name)%f$CLOSE_BRACKET"
    fi
    # Set Prompt
    setopt prompt_subst
    RPROMPT="$OPEN_BRACKET%F{$BLUE}%D{%a %b %f} - %D{%L:%M}%f$CLOSE_BRACKET"
    PROMPT="$TOP_LINE$HOST_NAME—$CWD$VENV_PROMPT $vcs_info_msg_0_
$BOTTOM_LINE$CIRCLE%F{$PINK}$(printf '\u0020\u0020')"
}

