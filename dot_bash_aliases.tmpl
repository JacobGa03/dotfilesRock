# Here are all the aliases for your bash scripting
# Alias's for multiple directory listing commands
alias la='ls -Alh'                # show hidden files
alias ls='ls -aFh' # add colors and file type extensions
alias lx='ls -lXBh'               # sort by extension
alias lk='ls -lSrh'               # sort by size
alias lc='ls -ltcrh'              # sort by change time
alias lu='ls -lturh'              # sort by access time
alias lr='ls -lRh'                # recursive ls
alias lt='ls -ltrh'               # sort by date
alias lm='ls -alh |more'          # pipe through 'more'
alias lw='ls -xAh'                # wide listing format
alias ll='ls -Fls'                # long listing format
alias labc='ls -lap'              # alphabetical sort
alias lf="ls -l | egrep -v '^d'"  # files only
alias ldir="ls -l | egrep '^d'"   # directories only
alias lla='ls -Al'                # List and Hidden Files
alias las='ls -A'                 # Hidden Files
alias lls='ls -l '                # List

# Make eza easier
alias e='eza'

# 'git' based aliases
alias gi='git init'
alias ga='git add'
alias gc='git commit -m'
alias gs='git status'
alias gpl='git pull'
alias gpu='git push'
alias gch='git checkout'
alias gcl='git clone'
alias gbr='git branch -v'
alias gf='git fetch'
alias gst='git stash'
{{- if lookPath "lazygit" }}
alias lg='lazygit'
{{ end }}

# Vim is Neovim
alias vim='nvim'
alias vi='nvim'
alias fzvim='vim -o `fzf`'
alias cd..='cd ..'
alias home='cd ~'

# Search running processes
alias p="ps aux | grep "
alias topcpu="/bin/ps -eo pcpu,pid,user,args | sort -k 1 -r | head -10"

# Count all files (recursively) in the current folder
alias countfiles="for t in files links directories; do echo \`find . -type \${t:0:1} | wc -l\` \$t; done 2> /dev/null"

alias tree='tree -CAhF --dirsfirst'
alias treed='tree -CAFd'

# Alias's for archives
alias mktar='tar -cvf'
alias mkgz='tar -cvzf'
alias untar='tar -xvf'
alias ungz='tar -xvzf'

# Clear terminal output
alias cls="clear"

# Coding Agent aliases 
{{- if lookPath "claude" }}
alias clc='claude --ide'
{{ end -}}
{{- if lookPath "opencode" }}
alias cc='opencode'
{{ end -}}
{{ if eq .chezmoi.os "linux" }}
{{ template "dot_bashrc_alias-linux" . }}
{{ else if eq .chezmoi.os "darwin" }}
{{ template "dot_bashrc_alias-macos" . }}
{{- end -}}
